# Скопируйте в .env и подставьте свои значения. Файл .env в git не попадает.

# Строка подключения MongoDB Atlas (Database -> Connect -> Drivers)
DB_URL="mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Секрет подписи JWT: длинная случайная строка. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="замените-на-случайную-строку"

# Необязательно (значения по умолчанию лежат в config/default.json):
# PORT=5000
# По умолчанию хранилище лежит в server/storage (путь считается от папки, откуда запущен node).
# Свой путь обязательно в папке, куда у вас есть право записи (НЕ в C:\Users и не в корень C:\):
# FILE_PATH="D:\cloud-disk\files"
# AVATAR_PATH="D:\cloud-disk\avatars"
# Временные файлы загрузки: лучше на том же диске, что и FILE_PATH (перенос = переименование)
# TEMP_PATH="D:\cloud-disk\tmp"
# Максимальный размер одного файла в байтах (по умолчанию 2 ГБ)
# MAX_UPLOAD_SIZE=2147483648
